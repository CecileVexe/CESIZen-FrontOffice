{
  // Contrôle des dépendances npm lancé par la CI (job security-audit).
  // La CI échoue dès qu'une faille de gravité haute ou critique est trouvée.
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  "high": true,
  "report-type": "important",
  // Exceptions temporaires (27/10/2026) : failles dont le seul correctif est la
  // migration Expo SDK 52 -> 58, prévue plus tard. Toutes se trouvent dans les
  // outils de build et de configuration d'Expo / React Native (CLI, Metro,
  // config plugins). Aucune n'est présente dans le bundle web publié.
  // À supprimer lors de la migration Expo.
  "allowlist": [
    // tar (via @expo/cli, cacache) : extraction d'archives par la CLI Expo.
    // La CI n'extrait que des paquets npm du registre officiel.
    "GHSA-34x7-hfp2-rc4v",
    "GHSA-8qq5-rm4j-mr97",
    "GHSA-83g3-92jg-28cx",
    "GHSA-qffp-2rhf-9h96",
    "GHSA-9ppj-qmqm-q256",
    "GHSA-r6q2-hw4h-h46w",
    "GHSA-23hp-3jrh-7fpw",
    "GHSA-8x88-c5mf-7j5w",
    "GHSA-r292-9mhp-454m",

    // @xmldom/xmldom (via @expo/config-plugins, @expo/plist) : lecture des
    // fichiers de configuration natifs (Info.plist, AndroidManifest) du projet.
    "GHSA-wh4c-j3r5-mjhp",
    "GHSA-2v35-w6hq-6mfw",
    "GHSA-f6ww-3ggp-fr8h",
    "GHSA-x6wf-f3px-wcqx",
    "GHSA-j759-j44w-7fr8",
    "GHSA-w2rr-34g9-rvrj",
    "GHSA-4w3w-2rp5-g8jm",
    "GHSA-c7q8-3ch8-vqpv",
    "GHSA-27p8-2357-5qqv",
    "GHSA-8344-3jmq-59r6",
    "GHSA-x4fp-j954-r2f4",
    "GHSA-965w-775f-mr7g",
    "GHSA-93r5-fhx6-vmg9",

    // image-size (via metro, react-native) : mesure des images du projet au build.
    "GHSA-5p2g-fcmc-qvqq",
    "GHSA-w3rx-r6r6-pgpr",

    // zod (via @expo/cli) : validation interne de la CLI Expo.
    "GHSA-mrhx-c7xc-m3w5"
  ]
}
